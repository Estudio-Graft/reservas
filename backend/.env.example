# Base de datos
DB_NAME=turnos_db
DB_USER=postgres
DB_PASSWORD=tu_password_de_postgres
DB_HOST=localhost

# Servidor
PORT=3000

# Autenticación
JWT_SECRET=cambiar_esto_por_una_frase_larga_y_secreta

# Admin inicial (se crea automáticamente la primera vez que se levanta el server)
ADMIN_EMAIL_INICIAL=admin@turnos.com
ADMIN_PASSWORD_INICIAL=A12345!

# Email (Gmail) — usar una "contraseña de aplicación", no tu contraseña normal de Gmail
# Se genera en: https://myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_contraseña_de_aplicacion
EMAIL_NOMBRE=Sistema de Turnos

# URL del frontend (se usa en el link de "reagendar" del email de cancelación)
FRONTEND_URL=http://localhost:5173
